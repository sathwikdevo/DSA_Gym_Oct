class Solution(object):
    def longestConsecutive(self, nums):
        """
        :type nums: List[int]
        :rtype: int
        """
        if not nums:
            return 0

        # 1. Implement custom Merge Sort O(n log n)
        def merge_sort(arr):
            if len(arr) <= 1:
                return arr
            
            mid = len(arr) // 2
            left = merge_sort(arr[:mid])
            right = merge_sort(arr[mid:])
            
            return merge(left, right)

        def merge(left, right):
            result = []
            i = j = 0
            while i < len(left) and j < len(right):
                if left[i] < right[j]:
                    result.append(left[i])
                    i += 1
                else:
                    result.append(right[j])
                    j += 1
            result.extend(left[i:])
            result.extend(right[j:])
            return result

        # 2. Implement custom Binary Search O(log n)
        def binary_search(arr, target):
            low, high = 0, len(arr) - 1
            while low <= high:
                mid = (low + high) // 2
                if arr[mid] == target:
                    return mid
                elif arr[mid] < target:
                    low = mid + 1
                else:
                    high = mid - 1
            return -1

        # Sort the array without using .sort()
        sorted_nums = merge_sort(nums)
        
        # Remove duplicates manually
        unique_nums = [sorted_nums[0]]
        for i in range(1, len(sorted_nums)):
            if sorted_nums[i] != sorted_nums[i - 1]:
                unique_nums.append(sorted_nums[i])

        max_len = 0
        
        # Find consecutive sequences
        for num in unique_nums:
            # Check if this number is the start of a sequence (i.e., num - 1 doesn't exist)
            if binary_search(unique_nums, num - 1) == -1:
                current_num = num
                current_len = 1
                
                # Count consecutive numbers using binary search
                while binary_search(unique_nums, current_num + 1) != -1:
                    current_num += 1
                    current_len += 1
                
                max_len = max(max_len, current_len)

        return max_len