class Solution(object):

  def threeSum(self, nums):
    """:type nums: List[int]

    :rtype: List[List[int]]
    """

    # 1. Implement your own Merge Sort to sort the array without using .sort()
    def merge_sort(arr):
      if len(arr) <= 1:
        return arr

      mid = len(arr) // 2
      left = merge_sort(arr[:mid])
      right = merge_sort(arr[mid:])

      return merge(left, right)

    def merge(left, right):
      sorted_arr = []
      i = j = 0
      while i < len(left) and j < len(right):
        if left[i] <= right[j]:
          sorted_arr.append(left[i])
          i += 1
        else:
          sorted_arr.append(right[j])
          j += 1
      sorted_arr.extend(left[i:])
      sorted_arr.extend(right[j:])
      return sorted_arr

    # 2. Implement your own Binary Search function to find a target in a sorted subarray
    def binary_search(arr, low, high, target):
      while low <= high:
        mid = (low + high) // 2
        if arr[mid] == target:
          return mid
        elif arr[mid] < target:
          low = mid + 1
        else:
          high = mid - 1
      return -1

    # Sort the array using custom merge sort
    sorted_nums = merge_sort(nums)
    result = set()
    n = len(sorted_nums)

    # 3. 3Sum logic using fixed first number and custom binary search for the third
    for i in range(n - 2):
      # Skip duplicate elements for the first number to avoid redundant triplets
      if i > 0 and sorted_nums[i] == sorted_nums[i - 1]:
        continue

      for j in range(i + 1, n - 1):
        # Skip duplicate elements for the second number
        if j > i + 1 and sorted_nums[j] == sorted_nums[j - 1]:
          continue

        # We need sorted_nums[i] + sorted_nums[j] + sorted_nums[k] == 0
        # Therefore, target for binary search is -(sorted_nums[i] + sorted_nums[j])
        target = -(sorted_nums[i] + sorted_nums[j])

        # Search for the target in the remaining portion of the array using custom BS
        k = binary_search(sorted_nums, j + 1, n - 1, target)

        if k != -1:
          result.add((sorted_nums[i], sorted_nums[j], sorted_nums[k]))

    # Convert the set of tuples back to a list of lists
    return [list(triplet) for triplet in result]