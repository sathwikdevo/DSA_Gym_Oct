def firstOccurrence(nums, target):
    left = 0
    right = len(nums) - 1
    first = -1

    while left <= right:
        mid = (left + right) // 2

        if nums[mid] == target:
            first = mid
            right = mid - 1
        elif nums[mid] < target:
            left = mid + 1
        else:
            right = mid - 1

    return first


def lastOccurrence(nums, target):
    left = 0
    right = len(nums) - 1
    last = -1

    while left <= right:
        mid = (left + right) // 2

        if nums[mid] == target:
            last = mid
            left = mid + 1
        elif nums[mid] < target:
            left = mid + 1
        else:
            right = mid - 1

    return last


def countOccurrences(nums, target):
    first = firstOccurrence(nums, target)
    last = lastOccurrence(nums, target)

    if first == -1:
        return 0

    return last - first + 1


# User input
nums = list(map(int, input("Enter sorted array elements: ").split()))
target = int(input("Enter target: "))

print("Count:", countOccurrences(nums, target))