
def bubble_sort(arr):
    n = len(arr)

    for i in range(n - 1):
        swapped = False

        for j in range(n - 1 - i):
            if arr[j] > arr[j + 1]:
                # Swap adjacent elements
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
                swapped = True

        # Early exit if no swaps occurred
        if not swapped:
            break

    return arr


numbers = [5, 2, 8, 1, 3]

print("Sorted array:", bubble_sort(numbers))
