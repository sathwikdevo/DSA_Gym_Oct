
class Solution:
    def rowAndMaximumOnes(self, mat):
        max_ones = -1
        row_index = 0

        for i in range(len(mat)):
            current_ones = 0

            for j in range(len(mat[i])):
                if mat[i][j] == 1:
                    current_ones += 1

            if current_ones > max_ones:
                max_ones = current_ones
                row_index = i

        return [row_index, max_ones]
