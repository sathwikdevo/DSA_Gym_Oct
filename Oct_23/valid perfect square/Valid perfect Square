class Solution(object):
    def isPerfectSquare(self, num):
        """
        :type num: int
        :rtype: bool
        """
        if num < 1:
            return False
        if num == 1:
            return True
        
        left = 1
        right = num // 2  # The square root of num can never exceed num // 2 for num > 1
        
        while left <= right:
            mid = left + (right - left) // 2
            
            # Use division (num // mid == mid and num % mid == 0) or mid * mid 
            # to check the square without risking integer overflow issues in other languages.
            squared = mid * mid
            
            if squared == num:
                return True
            elif squared < num:
                left = mid + 1
            else:
                right = mid - 1
                
        return False