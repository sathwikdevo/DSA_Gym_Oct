class Solution(object):
    def mySqrt(self, x):
        """
        :type x: int
        :rtype: int
        """
        if x < 2:
            return x
        
        left = 1
        right = x // 2  # Optimization: sqrt(x) can never exceed x // 2 for x >= 2
        ans = 0
        
        while left <= right:
            mid = left + (right - left) // 2
            
            # Condition check using standard multiplication to avoid built-ins
            if mid * mid == x:
                return mid
            elif mid * mid < x:
                ans = mid  # Store the valid floor value
                left = mid + 1
            else:
                right = mid - 1
                
        return ans