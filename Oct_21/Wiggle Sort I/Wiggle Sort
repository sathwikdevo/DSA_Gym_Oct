
class Solution:
    def wiggleSort(self, nums):
        for i in range(len(nums) - 1):
            if i % 2 == 0:
                if nums[i] > nums[i + 1]:
                    nums[i], nums[i + 1] = nums[i + 1], nums[i]
            else:
                if nums[i] < nums[i + 1]:
                    nums[i], nums[i + 1] = nums[i + 1], nums[i]


nums = list(map(int, input("Enter array elements: ").split()))

Solution().wiggleSort(nums)
print("Wiggle array:", nums)
