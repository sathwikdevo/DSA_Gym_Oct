class Solution(object):
    def sortColors(self, nums):
        """
        :type nums: List[int]
        :rtype: None Do not return anything, modify nums in-place instead.
        """
        low = 0
        mid = 0
        high = len(nums) - 1
        
        while mid <= high:
            if nums[mid] == 0:
                # Swap nums[low] and nums[mid], then advance both pointers
                nums[low], nums[mid] = nums[mid], nums[low]
                low += 1
                mid += 1
            elif nums[mid] == 1:
                # 1 is already in the correct middle section, just advance mid
                mid += 1
            else:
                # Swap nums[mid] and nums[high], shrink the high boundary
                # Note: Do not increment mid here because the swapped element 
                # from 'high' needs to be evaluated next.
                nums[mid], nums[high] = nums[high], nums[mid]
                high -= 1