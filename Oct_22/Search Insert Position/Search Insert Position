class Solution(object):
    def searchInsert(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: int
        """
        lo = 0
        hi = len(nums) - 1
        
        while lo <= hi:
            # Prevent potential overflow (though less of an issue in Python, it's great practice)
            mid = lo + (hi - lo) // 2
            
            if nums[mid] == target:
                return mid
            elif nums[mid] < target:
                lo = mid + 1
            else:
                hi = mid - 1
                
        # If the loop finishes without finding the target, `lo` points to the exact insert position
        return lo