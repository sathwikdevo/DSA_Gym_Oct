class Solution(object):
    def findInMountainArray(self, target, mountainArr):
        """
        :type target: integer
        :type mountain_arr: MountainArray
        :rtype: int
        """
        n = mountainArr.length()
        
        # Step 1: Find the index of the peak element
        left = 0
        right = n - 1
        while left < right:
            mid = left + (right - left) // 2
            if mountainArr.get(mid) < mountainArr.get(mid + 1):
                left = mid + 1
            else:
                right = mid
        peak = left
        
        # Step 2: Search in the strictly increasing left side
        l, r = 0, peak
        while l <= r:
            mid = l + (r - l) // 2
            val = mountainArr.get(mid)
            if val == target:
                return mid
            elif val < target:
                l = mid + 1
            else:
                r = mid - 1
        
        # Step 3: If not found, search in the strictly decreasing right side
        l, r = peak + 1, n - 1
        while l <= r:
            mid = l + (r - l) // 2
            val = mountainArr.get(mid)
            if val == target:
                return mid
            elif val < target:
                # Since the right side is decreasing, a smaller value means we need to go left (lower indices)
                r = mid - 1
            else:
                # A larger value means we need to go right (higher indices)
                l = mid + 1
                
        return -1